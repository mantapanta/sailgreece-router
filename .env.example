# --- Datenquelle ---------------------------------------------------------
# 'local'     = Staging-JSONs aus seeding/data/ (Standard fuer Entwicklung,
#               laeuft ohne Firebase-Projekt)
# 'firestore' = Firebase Firestore (Produktion, nach Seeding-Import)
VITE_DATA_SOURCE=local

# --- Google Maps ----------------------------------------------------------
# API-Key mit HTTP-Referrer- UND API-Restriction (Maps JavaScript API).
# Leer lassen ist erlaubt: die Karten-Ansicht zeigt dann einen Hinweis
# statt der Karte (kein Crash).
VITE_GOOGLE_MAPS_API_KEY=
# Pflicht fuer die Karte: Map-ID fuer AdvancedMarker (Google Cloud Console
# -> Map Management) — ohne sie zeigt die App einen Hinweis statt der Karte.
VITE_GOOGLE_MAPS_MAP_ID=

# --- Firebase --------------------------------------------------------------
# Pflicht: die App ist hinter Firebase Authentication (Google Sign-in)
# gesperrt. Ohne diese drei Werte zeigt der Login-Screen einen Hinweis statt
# des Google-Buttons — es gibt keinen Bypass.
# Werte holen:  npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID>
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional — wird sonst aus der Projekt-ID abgeleitet (<projectId>.firebaseapp.com).
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
