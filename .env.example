# --- Datenquelle ---------------------------------------------------------
# Nichts einzustellen: die Bibliothek kommt aus den Staging-JSONs in
# seeding/data/ und liegt im Bundle. Neue Daten = Commit + Deploy.
# (Firestore ist nur noch das ZIEL des Imports `npm run seed:import` — die
# App liest es nicht.)

# --- Google Maps ----------------------------------------------------------
# API-Key mit HTTP-Referrer- UND API-Restriction (Maps JavaScript API).
# Leer lassen ist erlaubt: die Karten-Ansicht zeigt dann einen Hinweis
# statt der Karte (kein Crash).
VITE_GOOGLE_MAPS_API_KEY=
# Pflicht fuer die Karte: Map-ID fuer AdvancedMarker (Google Cloud Console
# -> Map Management) — ohne sie zeigt die App einen Hinweis statt der Karte.
VITE_GOOGLE_MAPS_MAP_ID=
