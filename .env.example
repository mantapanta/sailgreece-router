# --- Datenquelle ---------------------------------------------------------
# 'local'     = Staging-JSONs aus seeding/data/ (Standard fuer Entwicklung,
#               laeuft ohne Firebase-Projekt)
# 'firestore' = Firebase Firestore (Produktion, nach Seeding-Import)
VITE_DATA_SOURCE=local

# --- Google Maps ----------------------------------------------------------
# API-Key mit HTTP-Referrer- UND API-Restriction (Maps JavaScript API).
# Leer lassen ist erlaubt: die Karten-Ansicht zeigt dann einen Hinweis
# statt der Karte (kein Crash).
VITE_GOOGLE_MAPS_API_KEY=
# Map-ID fuer AdvancedMarker (Google Cloud Console -> Map Management).
# 'DEMO_MAP_ID' funktioniert fuer die Entwicklung.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# --- Firebase (nur noetig bei VITE_DATA_SOURCE=firestore) -----------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
