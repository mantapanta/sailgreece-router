rules_version = '2';

// AD-5: Einziger programmatischer Schreiber sind die Seeding-Skripte
// (firebase-admin umgeht die Rules per Design).
//
// DIE APP LIEST FIRESTORE NICHT MEHR: sie bezieht die Bibliothek aus den
// Staging-JSONs im Bundle (src/adapters/library.ts). Damit ist auch der
// Google-Login entfallen, der nur wegen dieser Rules noetig war. Was hier
// steht, deckt nur noch das Import-Ziel ab — die Datenbank bleibt fuer
// unangemeldete Clients dicht und fuer alle schreibgeschuetzt.
service cloud.firestore {
  match /databases/{database}/documents {

    function istAngemeldet() {
      return request.auth != null && request.auth.uid != null;
    }

    // Bibliothek: Inseln, Plaetze, Etappen, Varianten, Konfiguration
    // (parameters, polar). Der Adapter liest genau diese fuenf.
    match /islands/{islandId} {
      allow read: if istAngemeldet();
      allow write: if false;
    }
    match /places/{placeId} {
      allow read: if istAngemeldet();
      allow write: if false;
    }
    // Etappen (legs). Fehlt dieser Block, liefert der Adapter eine leere
    // Etappenliste und der Solver hat keine Strecken — der Catch-All unten
    // sperrt jede Collection, die hier nicht steht.
    match /legs/{legId} {
      allow read: if istAngemeldet();
      allow write: if false;
    }
    // Routenvarianten (aus variants.json, Collection heisst 'routes').
    match /routes/{routeId} {
      allow read: if istAngemeldet();
      allow write: if false;
    }
    // Kite-Spots (aus kitespots.json). Eigene Collection, weil ein Spot nicht
    // zum Hafen gehoert (src/domain/schema/kite.ts). Fehlt dieser Block, bleibt
    // die Kite-Ebene leer — der Adapter faengt die Ablehnung ab, damit eine
    // nicht deployte Regel nicht die ganze Bibliothek mitnimmt.
    match /kiteSpots/{spotId} {
      allow read: if istAngemeldet();
      allow write: if false;
    }
    // Topografische Windzonen (aus windtopo.json): Windschatten und Kanaldüsen,
    // die das 7-km-Gitter von ICON-EU nicht aufloest
    // (src/domain/schema/windTopo.ts). Wie bei den Kite-Spots faengt der Adapter
    // eine Ablehnung ab — ohne diesen Block gibt es schlicht keine Korrektur.
    match /windTopoZones/{zoneId} {
      allow read: if istAngemeldet();
      allow write: if false;
    }
    match /config/{docId} {
      allow read: if istAngemeldet();
      allow write: if false;
    }

    // Alles Uebrige ist bewusst gesperrt — neue Collections muessen hier
    // ausdruecklich freigegeben werden, statt versehentlich offen zu stehen.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
