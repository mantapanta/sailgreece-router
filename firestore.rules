rules_version = '2';

// AD-5: Die App ist strikt lesend. Einziger programmatischer Schreiber sind
// die Seeding-Skripte (firebase-admin umgeht die Rules per Design).
//
// Lesen setzt eine Anmeldung voraus (Firebase Authentication, Google Sign-in):
// Toernbibliothek und sichere Liegeplaetze sind kuratierte, nicht-oeffentliche
// Daten.
service cloud.firestore {
  match /databases/{database}/documents {

    function istAngemeldet() {
      return request.auth != null && request.auth.uid != null;
    }

    // Bibliothek: Inseln, Plaetze, Etappen, Varianten, Konfiguration
    // (parameters, polar). Der Adapter liest genau diese fuenf.
    match /islands/{islandId} {
      allow read: if istAngemeldet();
      allow write: if false;
    }
    match /places/{placeId} {
      allow read: if istAngemeldet();
      allow write: if false;
    }
    // Etappen (legs). Fehlt dieser Block, liefert der Adapter eine leere
    // Etappenliste und der Solver hat keine Strecken — der Catch-All unten
    // sperrt jede Collection, die hier nicht steht.
    match /legs/{legId} {
      allow read: if istAngemeldet();
      allow write: if false;
    }
    // Routenvarianten (aus variants.json, Collection heisst 'routes').
    match /routes/{routeId} {
      allow read: if istAngemeldet();
      allow write: if false;
    }
    // Kite-Spots (aus kitespots.json). Der Import befuellt die Sammlung weiter,
    // aber DIE APP LIEST SIE NICHT MEHR: die Kite-Ebene kommt seit 2026-08-09
    // direkt aus der JSON-Datei im Bundle (src/adapters/firestore.ts,
    // Modulkopf), damit sie an keinem Import und an keiner Rule mehr haengt.
    // Der Block bleibt, weil die Daten liegen, wo sie liegen — und weil er
    // nichts oeffnet, was nicht ohnehin im Bundle steht.
    match /kiteSpots/{spotId} {
      allow read: if istAngemeldet();
      allow write: if false;
    }
    // Topografische Windzonen (aus windtopo.json): Windschatten und Kanaldüsen,
    // die das 7-km-Gitter von ICON-EU nicht aufloest
    // (src/domain/schema/windTopo.ts). Wie bei den Kite-Spots faengt der Adapter
    // eine Ablehnung ab — ohne diesen Block gibt es schlicht keine Korrektur.
    match /windTopoZones/{zoneId} {
      allow read: if istAngemeldet();
      allow write: if false;
    }
    match /config/{docId} {
      allow read: if istAngemeldet();
      allow write: if false;
    }

    // Alles Uebrige ist bewusst gesperrt — neue Collections muessen hier
    // ausdruecklich freigegeben werden, statt versehentlich offen zu stehen.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
